{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":combinePatchMinorReleases",
    ":enableVulnerabilityAlerts"
  ],
  "prConcurrentLimit": 10,
  "branchPrefix": "renovate/",
  "baseBranches": [
    "$default",
    "/^release\\/.*/"
  ]
}
