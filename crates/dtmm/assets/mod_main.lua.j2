local _G = _G
local rawget = rawget
local rawset = rawset

local log = function(category, format, ...)
    local Log = rawget(_G, "Log")
    if Log then
        Log.info(category, format, ...)
    else
        print(string.format("[%s] %s", category or "", string.format(format or "", ...)))
    end
end

log("mod_main", "Initializing mods...")
log("mod_main", "[DTMM] Deployment data:\n{{ deployment_info }}")

local require_store = {}

-- This token is treated as a string template and filled by DTMM during deployment.
-- This allows hiding unsafe I/O functions behind a setting.
-- When not replaced, it's also a valid table definition, thereby degrading gracefully.
local is_io_enabled = {{ is_io_enabled }} -- luacheck: ignore 113
local lua_libs = {
    debug = debug,
    os = {
        date = os.date,
        time = os.time,
        clock = os.clock,
        getenv = os.getenv,
        difftime = os.difftime,
    },
    load = load,
    loadfile = loadfile,
    loadstring = loadstring,
}

if is_io_enabled then
    lua_libs.io = io
    lua_libs.os = os
    lua_libs.ffi = require("ffi")
end

Mods = {
    -- Keep a backup of certain system libraries before
    -- Fatshark's code scrubs them.
    -- The loader can then decide to pass them on to mods, or ignore them
    lua = setmetatable({}, { __index = lua_libs }),
    require_store = require_store,
    original_require = require,
}

local can_insert = function(filepath, new_result)
    local store = require_store[filepath]
    if not store or #store then
        return true
    end

    if store[#store] ~= new_result then
        return true
    end
end

local original_require = require
require = function(filepath, ...)
    local result = original_require(filepath, ...)
    if result and type(result) == "table" then
        if can_insert(filepath, result) then
            require_store[filepath] = require_store[filepath] or {}
            local store = require_store[filepath]

            table.insert(store, result)

            if Mods.hook then
                Mods.hook.enable_by_file(filepath, #store)
            end
        end
    end

    return result
end

require("scripts/boot_init")
require("scripts/foundation/utilities/class")

-- The `__index` metamethod maps a proper identifier `CLASS.MyClassName` to the
-- stringified version of the key: `"MyClassName"`.
-- This allows using LuaCheck for the stringified class names in hook parameters.
_G.CLASS = setmetatable({}, {
    __index = function(_, key)
        return key
    end
})

local original_class = class
class = function(class_name, super_name, ...)
    local result = original_class(class_name, super_name, ...)
    if not rawget(_G, class_name) then
        rawset(_G, class_name, result)
    end
    if not rawget(_G.CLASS, class_name) then
        rawset(_G.CLASS, class_name, result)
    end
    return result
end

require("scripts/main")
log("mod_main", "'scripts/main' loaded")

-- Darktide drives its startup through `state_boot.lua`, which `require`s a
-- list of boot state modules (`start_params.boot_state_paths`) and runs them
-- in order. We inject one more state, right after
-- `boot_state_require_game_scripts`: at that point the package manager exists
-- (created by `boot_state_init_managers`) and the game's foundation scripts
-- are available (`boot_state_load_boot_assets` already ran).
--
-- The engine still looks for `scripts/mod_main` -- a leftover from the mod
-- manager Fatshark removed -- which is what lets us run this at all. Note that
-- `IS_MODDED` is derived from the `Mods` global in `boot_state_set_globals`,
-- so setting it above is what marks the session as modded.
local BOOT_STATE_LOAD_MODS_PATH = "scripts/mods/boot_state_load_mods"

local function patch_mod_loading_state()
    local StateBootSubStateBase = require("scripts/game_states/boot/state_boot_sub_state_base")

    local BootStateLoadMods = class("BootStateLoadMods", "StateBootSubStateBase")

    BootStateLoadMods.on_enter = function(self, ...)
        BootStateLoadMods.super.on_enter(self, ...)

        log("BootStateLoadMods", "Entered")

        self._package_handle = Managers.package:load("packages/mods", "BootStateLoadMods", nil)
    end

    BootStateLoadMods._state_update = function(self, _)
        if Managers.package:update() then
            local mod_data = require("scripts/mods/mod_data")

            local create_mod_loader = require("scripts/mods/init")
            local mod_loader = create_mod_loader(mod_data)

            Managers.mod = mod_loader

            log("BootStateLoadMods", "Mod loader initialized")
            return true
        end

        return false
    end

    BootStateLoadMods._state_cleanup = function(self, on_shutdown)
        if on_shutdown and self._package_handle then
            Managers.package:release(self._package_handle)
            self._package_handle = nil
        end
    end

    -- `state_boot.lua` resolves every path with `require`, so expose our class
    -- under that path rather than shipping another file in the boot bundle.
    package.preload[BOOT_STATE_LOAD_MODS_PATH] = function()
        return BootStateLoadMods
    end

    local GameStateMachine = require("scripts/foundation/utilities/game_state_machine")
    local GameStateMachine_init = GameStateMachine.init

    GameStateMachine.init = function(self, parent, start_state, params, optional_creation_context, state_change_callbacks, parent_name, name, log_breadcrumbs)
        if name == "Main" and params and params.boot_state_paths then
            local insert_at = #params.boot_state_paths + 1

            for i, path in ipairs(params.boot_state_paths) do
                if path == "scripts/game_states/boot/boot_state_require_game_scripts" then
                    insert_at = i + 1
                    break
                end
            end

            log("mod_main", "Injecting BootStateLoadMods at boot step %d", insert_at)
            table.insert(params.boot_state_paths, insert_at, BOOT_STATE_LOAD_MODS_PATH)
        end

        GameStateMachine_init(self, parent, start_state, params, optional_creation_context, state_change_callbacks, parent_name, name, log_breadcrumbs)
    end
end

-- Override `init` to run our injection
function init()
    patch_mod_loading_state()

    Main:init()
end

